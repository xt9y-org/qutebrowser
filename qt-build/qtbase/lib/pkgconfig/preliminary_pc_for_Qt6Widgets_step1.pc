prefix=/Users/felixjaschul/CLionProjects/qutebrowser/qt-webgpu
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
$<$<BOOL:>:mkspecsdir=${prefix}/mkspecs>
$<1: >
Name: Qt6 Widgets
Description: Qt Widgets module
Version: 6.11.2
Libs: -F${libdir} -framework QtWidgets $<$<BOOL:loose_link_options-NOTFOUND>:$<JOIN:$<REMOVE_DUPLICATES:loose_link_options-NOTFOUND>, >> $<JOIN:$<REMOVE_DUPLICATES:>, >
Cflags: -F${libdir} $<$<BOOL:${libdir}/QtWidgets.framework/Headers;${libdir}/QtWidgets.framework>:-I$<JOIN:$<REMOVE_DUPLICATES:${libdir}/QtWidgets.framework/Headers;${libdir}/QtWidgets.framework>, -I>> $<$<BOOL:QT_WIDGETS_LIB>:-D$<JOIN:$<REMOVE_DUPLICATES:QT_WIDGETS_LIB>, -D>>
Requires: $<JOIN:$<REMOVE_DUPLICATES:Qt6Core;Qt6Gui>, >
