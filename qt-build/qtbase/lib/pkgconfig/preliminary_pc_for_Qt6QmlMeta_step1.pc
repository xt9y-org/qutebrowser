prefix=/Users/felixjaschul/CLionProjects/qutebrowser/qt-webgpu
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
$<$<BOOL:>:mkspecsdir=${prefix}/mkspecs>
$<1: >
Name: Qt6 QmlMeta
Description: Qt QmlMeta module
Version: 6.11.2
Libs: -F${libdir} -framework QtQmlMeta $<$<BOOL:loose_link_options-NOTFOUND>:$<JOIN:$<REMOVE_DUPLICATES:loose_link_options-NOTFOUND>, >> $<JOIN:$<REMOVE_DUPLICATES:>, >
Cflags: -F${libdir} $<$<BOOL:${libdir}/QtQmlMeta.framework/Headers;${libdir}/QtQmlMeta.framework>:-I$<JOIN:$<REMOVE_DUPLICATES:${libdir}/QtQmlMeta.framework/Headers;${libdir}/QtQmlMeta.framework>, -I>> $<$<BOOL:QT_QMLMETA_LIB>:-D$<JOIN:$<REMOVE_DUPLICATES:QT_QMLMETA_LIB>, -D>>
Requires: $<JOIN:$<REMOVE_DUPLICATES:Qt6Qml;Qt6QmlModels;Qt6QmlWorkerScript>, >
