exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
$<$<BOOL:>:mkspecsdir=${prefix}/mkspecs>
$<1: >
Name: Qt6 QmlLocalStorage
Description: Qt QmlLocalStorage module
Version: 6.11.2
Libs: -F${libdir} -framework QtQmlLocalStorage $<$<BOOL:loose_link_options-NOTFOUND>:$<JOIN:$<REMOVE_DUPLICATES:loose_link_options-NOTFOUND>, >> $<JOIN:$<REMOVE_DUPLICATES:>, >
Cflags: -F${libdir} $<$<BOOL:${libdir}/QtQmlLocalStorage.framework/Headers;${libdir}/QtQmlLocalStorage.framework>:-I$<JOIN:$<REMOVE_DUPLICATES:${libdir}/QtQmlLocalStorage.framework/Headers;${libdir}/QtQmlLocalStorage.framework>, -I>> $<$<BOOL:QT_QMLLOCALSTORAGE_LIB>:-D$<JOIN:$<REMOVE_DUPLICATES:QT_QMLLOCALSTORAGE_LIB>, -D>>
Requires: $<JOIN:$<REMOVE_DUPLICATES:Qt6Sql>, >
