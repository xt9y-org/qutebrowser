prefix=/Users/felixjaschul/CLionProjects/qutebrowser/qt-webgpu
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
$<$<BOOL:>:mkspecsdir=${prefix}/mkspecs>
$<1: >
Name: Qt6 QmlCompiler
Description: Qt QmlCompiler module
Version: 6.11.2
Libs: -F${libdir} -framework QtQmlCompiler $<$<BOOL:loose_link_options-NOTFOUND>:$<JOIN:$<REMOVE_DUPLICATES:loose_link_options-NOTFOUND>, >> $<JOIN:$<REMOVE_DUPLICATES:>, >
Cflags: -F${libdir} $<$<BOOL:${libdir}/QtQmlCompiler.framework/Headers;${libdir}/QtQmlCompiler.framework>:-I$<JOIN:$<REMOVE_DUPLICATES:${libdir}/QtQmlCompiler.framework/Headers;${libdir}/QtQmlCompiler.framework>, -I>> $<$<BOOL:QT_QMLCOMPILER_LIB>:-D$<JOIN:$<REMOVE_DUPLICATES:QT_QMLCOMPILER_LIB>, -D>>
Requires: $<JOIN:$<REMOVE_DUPLICATES:Qt6Core;Qt6Qml>, >
