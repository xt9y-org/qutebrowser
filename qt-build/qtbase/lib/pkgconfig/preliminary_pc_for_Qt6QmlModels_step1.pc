prefix=/Users/felixjaschul/CLionProjects/qutebrowser/qt-webgpu
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
$<$<BOOL:>:mkspecsdir=${prefix}/mkspecs>
$<1: >
Name: Qt6 QmlModels
Description: Qt QmlModels module
Version: 6.11.2
Libs: -F${libdir} -framework QtQmlModels $<$<BOOL:loose_link_options-NOTFOUND>:$<JOIN:$<REMOVE_DUPLICATES:loose_link_options-NOTFOUND>, >> $<JOIN:$<REMOVE_DUPLICATES:>, >
Cflags: -F${libdir} $<$<BOOL:${libdir}/QtQmlModels.framework/Headers;${libdir}/QtQmlModels.framework>:-I$<JOIN:$<REMOVE_DUPLICATES:${libdir}/QtQmlModels.framework/Headers;${libdir}/QtQmlModels.framework>, -I>> $<$<BOOL:QT_QMLMODELS_LIB>:-D$<JOIN:$<REMOVE_DUPLICATES:QT_QMLMODELS_LIB>, -D>>
Requires: $<JOIN:$<REMOVE_DUPLICATES:Qt6Core;Qt6Qml>, >
