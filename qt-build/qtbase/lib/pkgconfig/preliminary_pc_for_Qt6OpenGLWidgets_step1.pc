prefix=/Users/felixjaschul/CLionProjects/qutebrowser/qt-webgpu
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
$<$<BOOL:>:mkspecsdir=${prefix}/mkspecs>
$<1: >
Name: Qt6 OpenGLWidgets
Description: Qt OpenGLWidgets module
Version: 6.11.2
Libs: -F${libdir} -framework QtOpenGLWidgets $<$<BOOL:loose_link_options-NOTFOUND>:$<JOIN:$<REMOVE_DUPLICATES:loose_link_options-NOTFOUND>, >> $<JOIN:$<REMOVE_DUPLICATES:>, >
Cflags: -F${libdir} $<$<BOOL:${libdir}/QtOpenGLWidgets.framework/Headers;${libdir}/QtOpenGLWidgets.framework>:-I$<JOIN:$<REMOVE_DUPLICATES:${libdir}/QtOpenGLWidgets.framework/Headers;${libdir}/QtOpenGLWidgets.framework>, -I>> $<$<BOOL:QT_OPENGLWIDGETS_LIB>:-D$<JOIN:$<REMOVE_DUPLICATES:QT_OPENGLWIDGETS_LIB>, -D>>
Requires: $<JOIN:$<REMOVE_DUPLICATES:Qt6OpenGL;Qt6Widgets>, >
