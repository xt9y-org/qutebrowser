prefix=/Users/felixjaschul/CLionProjects/qutebrowser/qt-webgpu
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
$<$<BOOL:>:mkspecsdir=${prefix}/mkspecs>
$<1: >
Name: Qt6 QmlCore
Description: Qt QmlCore module
Version: 6.11.2
Libs: -F${libdir} -framework QtQmlCore $<$<BOOL:loose_link_options-NOTFOUND>:$<JOIN:$<REMOVE_DUPLICATES:loose_link_options-NOTFOUND>, >> $<JOIN:$<REMOVE_DUPLICATES:>, >
Cflags: -F${libdir} $<$<BOOL:${libdir}/QtQmlCore.framework/Headers;${libdir}/QtQmlCore.framework>:-I$<JOIN:$<REMOVE_DUPLICATES:${libdir}/QtQmlCore.framework/Headers;${libdir}/QtQmlCore.framework>, -I>> $<$<BOOL:QT_QMLCORE_LIB>:-D$<JOIN:$<REMOVE_DUPLICATES:QT_QMLCORE_LIB>, -D>>
Requires: $<JOIN:$<REMOVE_DUPLICATES:Qt6Core;Qt6Qml>, >
