prefix=/Users/felixjaschul/CLionProjects/qutebrowser/qt-webgpu
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
$<$<BOOL:>:mkspecsdir=${prefix}/mkspecs>
$<1: >
Name: Qt6 Gui
Description: Qt Gui module
Version: 6.11.2
Libs: -F${libdir} -framework QtGui $<$<BOOL:loose_link_options-NOTFOUND>:$<JOIN:$<REMOVE_DUPLICATES:loose_link_options-NOTFOUND>, >> $<JOIN:$<REMOVE_DUPLICATES:>, >
Cflags: -F${libdir} $<$<BOOL:${libdir}/QtGui.framework/Headers;${libdir}/QtGui.framework>:-I$<JOIN:$<REMOVE_DUPLICATES:${libdir}/QtGui.framework/Headers;${libdir}/QtGui.framework>, -I>> $<$<BOOL:QT_GUI_LIB>:-D$<JOIN:$<REMOVE_DUPLICATES:QT_GUI_LIB>, -D>>
Requires: $<JOIN:$<REMOVE_DUPLICATES:Qt6Core>, >
