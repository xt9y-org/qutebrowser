prefix=/Users/felixjaschul/CLionProjects/qutebrowser/qt-webgpu
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
$<$<BOOL:>:mkspecsdir=${prefix}/mkspecs>
$<1: >
Name: Qt6 Sql
Description: Qt Sql module
Version: 6.11.2
Libs: -F${libdir} -framework QtSql $<$<BOOL:loose_link_options-NOTFOUND>:$<JOIN:$<REMOVE_DUPLICATES:loose_link_options-NOTFOUND>, >> $<JOIN:$<REMOVE_DUPLICATES:>, >
Cflags: -F${libdir} $<$<BOOL:${libdir}/QtSql.framework/Headers;${libdir}/QtSql.framework>:-I$<JOIN:$<REMOVE_DUPLICATES:${libdir}/QtSql.framework/Headers;${libdir}/QtSql.framework>, -I>> $<$<BOOL:QT_SQL_LIB>:-D$<JOIN:$<REMOVE_DUPLICATES:QT_SQL_LIB>, -D>>
Requires: $<JOIN:$<REMOVE_DUPLICATES:Qt6Core>, >
