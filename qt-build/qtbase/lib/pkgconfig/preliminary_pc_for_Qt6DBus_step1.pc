prefix=/Users/felixjaschul/CLionProjects/qutebrowser/qt-webgpu
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
$<$<BOOL:>:mkspecsdir=${prefix}/mkspecs>
$<1: >
Name: Qt6 DBus
Description: Qt DBus module
Version: 6.11.2
Libs: -F${libdir} -framework QtDBus $<$<BOOL:loose_link_options-NOTFOUND>:$<JOIN:$<REMOVE_DUPLICATES:loose_link_options-NOTFOUND>, >> $<JOIN:$<REMOVE_DUPLICATES:>, >
Cflags: -F${libdir} $<$<BOOL:${libdir}/QtDBus.framework/Headers;${libdir}/QtDBus.framework>:-I$<JOIN:$<REMOVE_DUPLICATES:${libdir}/QtDBus.framework/Headers;${libdir}/QtDBus.framework>, -I>> $<$<BOOL:QT_DBUS_LIB>:-D$<JOIN:$<REMOVE_DUPLICATES:QT_DBUS_LIB>, -D>>
Requires: $<JOIN:$<REMOVE_DUPLICATES:Qt6Core>, >
